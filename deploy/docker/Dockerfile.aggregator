# AKIL Aggregator — Multi-stage Dockerfile
# Produces a minimal image with the aggregator binary.

# Stage 1: Build
FROM golang:1.22-bookworm AS builder

WORKDIR /build
COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -ldflags="-s -w" -o /akil-aggregator ./cmd/aggregator/

# Stage 2: Runtime
FROM gcr.io/distroless/static-debian12:nonroot

COPY --from=builder /akil-aggregator /akil-aggregator

USER nonroot:nonroot

EXPOSE 50051

ENTRYPOINT ["/akil-aggregator"]
